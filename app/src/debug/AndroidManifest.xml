<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a folder for device tests of the notes folder (SAF), with no picker. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name=".TestDocumentsProvider"
            android:authorities="dev.abhay.assistant.testdocs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.provider.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
