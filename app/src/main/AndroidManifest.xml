<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission: the model is bundled and runs on the phone, and the app never goes
         online. `mise run check-offline` checks the built APK. -->

    <!-- ML Kit (Gemini Nano voice, POC) merges these in for Google's usage logs (transport-backend-cct).
         Removed: Ferb never goes online, so the library can't send its logs. Speech runs in AICore. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- set_alarm and set_timer: ask the clock app (a normal permission, granted at install). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- make_call and send_text: find the person in the contacts, on the phone. make_call: call
         the contact the user picks at once; anything not picked only opens the dialer. Messages go
         through the messages app (no SEND_SMS): the user presses send there. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- show_agenda: read the calendar's events. add_event: also add events (and delete one with
         Undo), straight into the calendar provider; Google Calendar syncs them. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Voice, only through Ferb Link: record a spoken request, which Ferb Link sends to the
         user's computer to transcribe. Ferb itself still has no INTERNET permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- A low-latency Wi-Fi lock while a request is with the computer (Ferb Link): Wi-Fi power
         save delayed each one by about a second. Not network access: Ferb still has no INTERNET. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Reminders: Ferb's own notifications, at the exact time (an alarm, granted with the app on
         Android 13+ for reminder apps), rescheduled after a reboot. All on the phone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- open_app: see the launchable apps, to find one by name (package visibility).
         create_note: see the notes apps that take a note from another app. -->
    <queries>
        <!-- Obsidian, to open notes there (obsidian://open links): visibility only, no permission. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="obsidian" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.actions.CREATE_NOTE" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Ferb Link, the optional companion app that holds the internet access Ferb doesn't have
             and passes requests to a model on the user's own computer (link/FerbLink.kt). -->
        <package android:name="dev.abhay.ferblink" />
    </queries>

    <application
        android:name=".AssistantApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Assistant">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The phone's assistant: an exported activity for ACTION_ASSIST is enough for
                 Android's assistant role (RoleManager's AssistantRoleBehavior also accepts a
                 VoiceInteractionService, not needed yet). Picked by the user in Settings → Apps →
                 Default apps → Digital assistant app; holding the power button or the corner
                 swipe then opens Ferb's chat. No permission, and no screen context asked for. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- A reminder's notification, its Done and Snooze, a reboot, the daily rescan of the notes folder. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
