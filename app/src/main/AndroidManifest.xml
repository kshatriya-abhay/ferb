<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: the model is bundled and runs on the phone, and the app never goes
         online. `mise run check-offline` checks the built APK. -->

    <!-- set_alarm and set_timer: ask the clock app (a normal permission, granted at install). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- make_call and send_text: find the person in the contacts, on the phone. make_call: call
         the contact the user picks at once; anything not picked only opens the dialer. Messages go
         through the messages app (no SEND_SMS): the user presses send there. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- open_app: see the launchable apps, to find one by name (package visibility).
         create_note: see the notes apps that take a note from another app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.actions.CREATE_NOTE" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".AssistantApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Assistant">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
