<!-- A slab-serif F with a spanner tucked under its middle bar: Ferb, who builds things.
     Centred in the adaptive icon's 66dp safe zone. Also the monochrome (themed) icon, which uses
     only the alpha, so nothing here may be drawn in the background colour: the spanner's jaw is
     a gap in its outline, not a shape painted over it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Drawn on a 100-unit grid (F from 26,24 to 66,74), scaled to the size it had in the design. -->
    <group
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:translateX="11.92"
        android:translateY="15.39">
        <path
            android:fillColor="#F7F3E8"
            android:pathData="M26,24H66V38H60V31H42V44H52V40H56V56H52V52H42V68H48V74H26V68H32V31H26Z" />
        <!-- Open-ended spanner, jaw up and to the right; drawn upright, then turned 45°. -->
        <group
            android:rotation="45"
            android:translateX="63"
            android:translateY="63">
            <path
                android:fillColor="#F2A541"
                android:pathData="M-3.5,-5.71L-3.5,12A3.5,3.5 0,0 0,3.5 12L3.5,-5.71A9,9 0,0 0,3.5 -22.29L3.5,-14A3.5,3.5 0,0 1,-3.5 -14L-3.5,-22.29A9,9 0,0 0,-3.5 -5.71Z" />
        </group>
    </group>
</vector>
